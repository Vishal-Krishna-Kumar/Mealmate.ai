ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
MODEL_PATH=./models/recommender.pkl
DATA_PATH=./data/recipes.csv
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5000

# Optional: Gemini configuration. Leave GEMINI_API_KEY blank to disable LLM
# features (assistant chat, smart pantry paste, vision pantry capture,
# LLM week-planner). All LLM-powered surfaces have offline fallbacks.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=text-embedding-004

# Optional: TTL-LRU cache for Gemini responses (saves money + latency).
LLM_CACHE_TTL_SECONDS=900
LLM_CACHE_MAX_ENTRIES=512
